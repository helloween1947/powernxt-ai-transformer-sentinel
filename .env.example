# ==============================================================================
# PowerNXT Transformer Sentinel - Environment Configuration Template
# Copy this file to .env:
#   PowerShell: Copy-Item .env.example .env
#
# IMPORTANT DATABASE HOSTNAME CONVENTION:
# - When running the backend directly on Windows (Local Python virtual environment):
#     DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_pw@localhost:5433/sentinel_db
#     (PostgreSQL port 5433 is mapped to Windows localhost)
#
# - When running the backend inside Docker Compose:
#     DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_pw@db:5432/sentinel_db
#     (Docker network resolves container hostname 'db')
# ==============================================================================

# Application environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Credentials & Configuration
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_pw
POSTGRES_DB=sentinel_db
POSTGRES_PORT=5433

# Active Database Connection String for Local Windows Execution:
DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_pw@localhost:5433/sentinel_db

# CORS Allowed Origins (JSON array required by pydantic-settings)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
